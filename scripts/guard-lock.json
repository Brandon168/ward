{
  "manifest": {
    "permissions": [
      "storage",
      "activeTab",
      "scripting",
      "unlimitedStorage",
      "idle",
      "alarms",
      "contextMenus",
      "offscreen",
      "clipboardWrite"
    ],
    "optional_permissions": [],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "optional_host_permissions": [],
    "content_scripts": [
      {
        "matches": [
          "https://*/*"
        ],
        "js": [
          "page.js"
        ],
        "run_at": "document_start",
        "world": "MAIN"
      },
      {
        "matches": [
          "https://*/*"
        ],
        "js": [
          "bridge.js"
        ],
        "run_at": "document_start"
      },
      {
        "matches": [
          "https://*/*",
          "http://*/*"
        ],
        "js": [
          "inpage.js"
        ],
        "run_at": "document_start",
        "all_frames": true
      }
    ],
    "web_accessible_resources": [],
    "externally_connectable": null,
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "key": ""
  },
  "network": {
    "background.js": {
      "fetch": 1,
      "WebSocket": 1,
      "openWindow": 2
    },
    "bw.js": {
      "fetch": 2
    },
    "popup.js": {
      "openWindow": 2
    },
    "sync.js": {
      "WebSocket": 1
    }
  },
  "urls": [
    "http://www.w3.org",
    "https://${requested}",
    "https://${rpid}",
    "https://${u}",
    "https://${value}",
    "https://api.bitwarden.${cloud[1]}",
    "https://identity.bitwarden.${cloud[1]}",
    "https://vault.bitwarden.com",
    "https://vault.example.com"
  ],
  "files": [
    "LICENSE",
    "autofill.js",
    "background.js",
    "bridge.js",
    "bw.js",
    "coord.js",
    "formfill.js",
    "gen.js",
    "icons/128.png",
    "icons/16.png",
    "icons/48.png",
    "inpage.js",
    "manifest.json",
    "offscreen.html",
    "offscreen.js",
    "page.js",
    "popup.css",
    "popup.html",
    "popup.js",
    "sync.js",
    "theme.js",
    "touch.js",
    "twostep.js",
    "vendor/argon2.umd.min.js",
    "vendor/eff_large_wordlist.js",
    "vendor/hash-wasm.LICENSE",
    "vendor/public_suffix_list.js"
  ],
  "vendor": {
    "vendor/argon2.umd.min.js": "dcec617a2e1b700fa132d1583a186cb70611113395e869f2dd6cc82b415d3094",
    "vendor/eff_large_wordlist.js": "307c728d647abec2292b3dd189460a2dc1ffc71521d5e2512461161a7791c37b",
    "vendor/hash-wasm.LICENSE": "c14dea172f72f2714284a0ac2ab1b00b5352a01409d58255a46227ffc541debd",
    "vendor/public_suffix_list.js": "deb48c9627b5d40dc77cf67e0a3208091f0f8fd4da59a7c22b19a3f7d1858840"
  }
}
